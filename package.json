{
  "name": "@yerba-buena/metrc-ny-client",
  "version": "0.1.0-dev",
  "description": "METRC v2 API client for New York facilities. Live + mock implementations behind a shared interface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "discover": "npx tsx scripts/discover-schemas.ts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "20.19.27",
    "@vitest/coverage-v8": "4.1.5",
    "dotenv": "17.4.2",
    "typescript": "5.6.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerba-buena/metrc-ny-client.git"
  }
}
